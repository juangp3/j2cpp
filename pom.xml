<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>se.arnetheduck</groupId>
	<artifactId>j2c-cli</artifactId>
	<version>0.6.0</version>
	<name>J2C command-line translator</name>

	<properties>
		<maven.compiler.release>11</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<jdt.version>3.32.0</jdt.version>
		<eclipse.runtime.version>3.26.100</eclipse.runtime.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.eclipse.jdt</groupId>
			<artifactId>org.eclipse.jdt.core</artifactId>
			<version>${jdt.version}</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.platform</groupId>
			<artifactId>org.eclipse.core.runtime</artifactId>
			<version>${eclipse.runtime.version}</version>
		</dependency>
	</dependencies>

	<build>
		<sourceDirectory>plugin/src</sourceDirectory>
		<resources>
			<resource>
				<directory>plugin/src</directory>
				<includes>
					<include>se/arnetheduck/j2c/resources/**</include>
				</includes>
			</resource>
			<resource>
				<directory>${project.basedir}</directory>
				<targetPath>META-INF/j2c-licenses</targetPath>
				<includes>
					<include>LICENSE</include>
					<include>THIRD-PARTY-NOTICES.txt</include>
				</includes>
			</resource>
			<resource>
				<directory>licenses</directory>
				<targetPath>META-INF/j2c-licenses/licenses</targetPath>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<includes>
						<include>se/arnetheduck/j2c/cli/**/*.java</include>
						<include>se/arnetheduck/j2c/snippets/**/*.java</include>
						<include>se/arnetheduck/j2c/transform/**/*.java</include>
					</includes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<finalName>j2c-cli</finalName>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>module-info.class</exclude>
										<!-- Per-bundle notices collide when shaded; the originals
										     are preserved under META-INF/j2c-licenses instead. -->
										<exclude>about.html</exclude>
										<exclude>about_files/**</exclude>
										<exclude>META-INF/LICENSE</exclude>
										<exclude>META-INF/NOTICE</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>se.arnetheduck.j2c.cli.Main</mainClass>
									<manifestEntries>
										<Implementation-Title>J2C</Implementation-Title>
										<Implementation-Version>${project.version}</Implementation-Version>
									</manifestEntries>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
