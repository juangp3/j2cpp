{
  "name": "j2c",
  "displayName": "J2C Java to C++",
  "description": "Translate Java source code to C++ using the J2C converter.",
  "version": "0.6.0",
  "publisher": "juangp3",
  "license": "EPL-1.0",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/juangp3/j2cpp.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "node scripts/prepare.js",
    "test:cli": "node scripts/test-cli.js",
    "test:extension": "node scripts/test-extension.js",
    "test:licenses": "node scripts/check-licenses.js",
    "test:mcp": "node scripts/test-mcp.js",
    "probe": "node scripts/probe.js",
    "corpus": "node scripts/corpus.js",
    "runtime": "node scripts/runtime-programs.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  },
  "activationEvents": [
    "onCommand:j2c.translate",
    "onCommand:j2c.check",
    "onMcpCollection:j2c"
  ],
  "contributes": {
    "commands": [
      {
        "command": "j2c.translate",
        "title": "J2C: Translate to C++"
      },
      {
        "command": "j2c.check",
        "title": "J2C: Check Translatability"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "j2c.translate",
          "when": "editorLangId == java"
        },
        {
          "command": "j2c.check",
          "when": "editorLangId == java"
        }
      ],
      "explorer/context": [
        {
          "command": "j2c.translate",
          "when": "resourceLangId == java || explorerResourceIsFolder",
          "group": "navigation"
        },
        {
          "command": "j2c.check",
          "when": "resourceLangId == java || explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "J2C",
      "properties": {
        "j2c.sourcePaths": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Java source roots relative to the workspace folder. Defaults to java.project.sourcePaths, then conventional src folders."
        },
        "j2c.classPath": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Dependency jars or class directories, absolute or relative to the workspace folder."
        },
        "j2c.cliJar": {
          "type": "string",
          "default": "",
          "description": "Optional path to a J2C CLI jar. The packaged extension includes one by default."
        },
        "j2c.javaExecutable": {
          "type": "string",
          "default": "java",
          "description": "Java 11 or newer executable used to run the bundled CLI."
        },
        "j2c.sealedTypes": {
          "type": "string",
          "enum": ["advisory", "reject"],
          "default": "advisory",
          "description": "How to handle Java sealed and non-sealed types. Advisory emits C++ inheritance and informational permits comments; reject stops translation."
        },
        "j2c.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Offer J2C's check, translate, explain and capabilities tools to AI agents (such as Copilot agent mode) as an MCP server for each workspace folder. Requires a VS Code version with MCP support."
        },
        "j2c.tests": {
          "type": "boolean",
          "default": false,
          "description": "Check JUnit 4 and 5 tests and generate GoogleTest wrappers that run them (`make test` in the output folder). Requires the JUnit JARs in j2c.classPath."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "j2c",
        "label": "J2C Java to C++"
      }
    ]
  }
}
