INCLUDES := $(INCLUDES) -Isrc -Iext/src -Iruntime
EXTRA_LIBS ?= -l$(NAME)-ext

CPPFLAGS := $(CPPFLAGS) $(INCLUDES)
# Array indices are checked as in Java; CFLAGS=-DJ2C_NO_BOUNDS_CHECKS in the
# environment removes the checks (an index out of range is then undefined)
CFLAGS := $(CFLAGS) -g -pipe -MMD -MP
# Java integer arithmetic wraps on overflow; -pthread for java.lang.Thread
CXXFLAGS := $(CFLAGS) -std=c++20 -fwrapv -pthread

# make J2C_GC=boehm links the programs (mains) with the Boehm garbage
# collector (libgc), which then serves every allocation; override GC_CFLAGS
# and GC_LIBS when bdw-gc is not known to pkg-config
J2C_GC ?=
ifeq ($(J2C_GC),boehm)
GC_CFLAGS ?= $(shell pkg-config --cflags bdw-gc 2>/dev/null)
GC_LIBS ?= $(shell pkg-config --libs bdw-gc 2>/dev/null || echo -lgc)
CPPFLAGS := $(CPPFLAGS) -DJ2C_GC_BOEHM $(GC_CFLAGS)
GC_LDLIBS = -Wl,--wrap=__cxa_throw $(GC_LIBS)
else ifneq ($(J2C_GC),)
$(error J2C_GC must be empty or boehm, not $(J2C_GC))
endif

BIN := bin
OBJ := obj

# J2C keeps obj/ when it translates again, so objects are rebuilt when the
# compiler or its flags change: FLAGS_FILE holds them, and is rewritten only
# when they differ
FLAGS_FILE := $(OBJ)/flags.txt
FLAGS_TEXT := $(CXX) $(CPPFLAGS) $(CXXFLAGS)
$(shell mkdir -p $(OBJ) && printf '%%s\n' '$(subst ','\'',$(FLAGS_TEXT))' > $(FLAGS_FILE).new && if cmp -s $(FLAGS_FILE).new $(FLAGS_FILE); then rm -f $(FLAGS_FILE).new; else mv -f $(FLAGS_FILE).new $(FLAGS_FILE); fi)

NAME := %1$s

LIB = lib$(NAME).a
EXT_LIB = lib$(NAME)-ext.a

LIBS = $(BIN)/$(LIB) $(BIN)/$(EXT_LIB)
# The runtime in the ext library refers back to the program's classes, and
# single-pass linkers need the program library again after it
LINK_LIBS = -l$(NAME) $(EXTRA_LIBS) -l$(NAME)

SRC = src
STUB = stub
NATIVE = native

SRCS = \
%2$s

STUB_SRCS = \
%3$s

NATIVE_SRCS = \
%4$s

EXT_SRCS = \
%5$s

EXT_STUB_SRCS = \
%6$s

EXT_NATIVE_SRCS = \
%7$s

MAIN_SRCS = \
%8$s

# GoogleTest wrappers generated from JUnit tests (j2c --tests)
TEST_SRCS = \
%9$s

# Hand-written C++ of a J2C runtime (j2c --runtime)
RUNTIME_SRCS = \
%10$s

# gMock classes generated from Java interfaces (j2c --mocks), in mock/
MOCK_HDRS = \
%11$s

# Hand-written GoogleTest files in test/ to build into the tests binary,
# such as tests using the mocks: make tests USER_TEST_SRCS=test/my_test.cpp
USER_TEST_SRCS ?=

MAINS = $(MAIN_SRCS:$(SRC)/%%-main.cpp=$(BIN)/%%)
OBJS = $(SRCS:$(SRC)/%%.cpp=$(OBJ)/%%.o)
STUB_OBJS = $(STUB_SRCS:$(STUB)/%%.cpp=$(OBJ)/%%.o)
NATIVE_OBJS = $(NATIVE_SRCS:$(NATIVE)/%%.cpp=$(OBJ)/%%.o)

EXT_OBJS = $(EXT_SRCS:ext/$(SRC)/%%.cpp=$(OBJ)/%%.o)
EXT_STUB_OBJS = $(EXT_STUB_SRCS:ext/$(STUB)/%%.cpp=$(OBJ)/%%.o)
EXT_NATIVE_OBJS = $(EXT_NATIVE_SRCS:ext/$(NATIVE)/%%.cpp=$(OBJ)/%%.o)

RUNTIME_OBJS = $(RUNTIME_SRCS:runtime/%%.cpp=$(OBJ)/runtime/%%.o)

TEST_OBJS = $(TEST_SRCS:test/%%.cpp=$(OBJ)/test/%%.o) $(USER_TEST_SRCS:test/%%.cpp=$(OBJ)/test/%%.o)
TESTS_BIN = $(BIN)/$(NAME)-tests
# Override these when GoogleTest is not known to pkg-config
GTEST_CFLAGS ?= $(shell pkg-config --cflags gtest_main 2>/dev/null)
GTEST_LIBS ?= $(shell pkg-config --libs gtest_main 2>/dev/null || echo -lgtest_main -lgtest -pthread)
# Extra objects or libraries for the test binary, such as a Java runtime
TEST_LDLIBS ?=
# gMock, for tests using the mocks; override these when it is not known to
# pkg-config
ifneq ($(strip $(MOCK_HDRS)),)
GMOCK_CFLAGS ?= $(shell pkg-config --cflags gmock 2>/dev/null)
GMOCK_LIBS ?= $(shell pkg-config --libs gmock 2>/dev/null || echo -lgmock)
endif

all: $(LIBS)

define cc-command
@mkdir -p $(dir $@); 
@echo Compile $<; $(CXX) $(CPPFLAGS) $(CXXFLAGS) -c -o $@ $<
endef

$(OBJS):$(OBJ)/%%.o: $(SRC)/%%.cpp $(FLAGS_FILE) | print-opts
	$(cc-command)
	
$(STUB_OBJS):$(OBJ)/%%.o: $(STUB)/%%.cpp $(FLAGS_FILE) | print-opts
	$(cc-command)

$(NATIVE_OBJS):$(OBJ)/%%.o: $(NATIVE)/%%.cpp $(FLAGS_FILE) | print-opts
	$(cc-command)

$(EXT_OBJS):$(OBJ)/%%.o: ext/$(SRC)/%%.cpp $(FLAGS_FILE) | print-opts
	$(cc-command)

$(EXT_STUB_OBJS):$(OBJ)/%%.o: ext/$(STUB)/%%.cpp $(FLAGS_FILE) | print-opts
	$(cc-command)

$(EXT_NATIVE_OBJS):$(OBJ)/%%.o: ext/$(NATIVE)/%%.cpp $(FLAGS_FILE) | print-opts
	$(cc-command)

$(RUNTIME_OBJS):$(OBJ)/runtime/%%.o: runtime/%%.cpp $(FLAGS_FILE) | print-opts
	$(cc-command)

%%.a:
	@echo Archive $@
	@mkdir -p $(dir $@)
	@rm -f $@
	@ar rcs $@ $(filter %%.o,$^)

# Also after the Makefile: J2C keeps the libraries when it translates again,
# and a library whose sources were removed must be archived again
$(BIN)/$(LIB): $(OBJS) $(STUB_OBJS) $(NATIVE_OBJS) Makefile

$(BIN)/$(EXT_LIB): $(EXT_OBJS) $(EXT_STUB_OBJS) $(EXT_NATIVE_OBJS) $(RUNTIME_OBJS) Makefile

$(MAINS):$(BIN)/%%:$(SRC)/%%-main.cpp $(LIBS)
	@mkdir -p $(dir $@); 
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -L$(BIN) -o $@ $< $(LINK_LIBS) $(GC_LDLIBS)

mains: $(MAINS)

$(TEST_OBJS):$(OBJ)/test/%%.o: test/%%.cpp $(FLAGS_FILE) | print-opts
	@mkdir -p $(dir $@);
	@echo Compile $<; $(CXX) $(CPPFLAGS) -Itest -Imock $(GMOCK_CFLAGS) $(GTEST_CFLAGS) $(CXXFLAGS) -c -o $@ $<

$(TESTS_BIN): $(TEST_OBJS) $(LIBS)
	@mkdir -p $(dir $@);
	$(CXX) $(CXXFLAGS) -L$(BIN) -o $@ $(TEST_OBJS) $(LINK_LIBS) $(TEST_LDLIBS) $(GMOCK_LIBS) $(GTEST_LIBS)

tests: $(TESTS_BIN)

test: $(TESTS_BIN)
	$(TESTS_BIN)

clean:
	rm -rf $(OBJ) $(BIN)

$(FLAGS_FILE): ;

print-opts:
	@echo Building with \"$(CXX) $(CPPFLAGS) $(CXXFLAGS)\"
	
.PHONY: all mains tests test clean print-opts

-include $(OBJS:%%.o=%%.d) $(STUB_OBJS:%%.o=%%.d) $(NATIVE_OBJS:%%.o=%%.d) \
	$(EXT_OBJS:%%.o=%%.d) $(EXT_STUB_OBJS:%%.o=%%.d) \
	$(EXT_NATIVE_OBJS:%%.o=%%.d) $(RUNTIME_OBJS:%%.o=%%.d) \
	$(TEST_OBJS:%%.o=%%.d)
